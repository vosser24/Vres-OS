{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/bin/vres-hook.ps1",
              "session-start"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/bin/vres-hook.ps1",
              "user-prompt"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^AskUserQuestion$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/bin/vres-user-answer.ps1"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(?!mcp__plugin_vres-os_vres__(task_checkpoint|task_reply_gate|reply_activity_observe)$).+",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:vres-os:vres",
            "tool": "reply_activity_observe",
            "input": {
              "session_id": "${session_id}",
              "tool_name": "${tool_name}",
              "tool_use_id": "${tool_use_id}",
              "event_name": "${hook_event_name}",
              "agent_id": "${agent_id}"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^(?!mcp__plugin_vres-os_vres__(task_checkpoint|task_reply_gate|reply_activity_observe)$).+",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:vres-os:vres",
            "tool": "reply_activity_observe",
            "input": {
              "session_id": "${session_id}",
              "tool_name": "${tool_name}",
              "tool_use_id": "${tool_use_id}",
              "event_name": "${hook_event_name}",
              "agent_id": "${agent_id}"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/bin/vres-hook.ps1",
              "pre-compact"
            ]
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/bin/vres-hook.ps1",
              "post-compact"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/bin/vres-hook.ps1",
              "stop"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/bin/vres-session-end.ps1"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^vres-os:routing-arbiter$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/bin/vres-subagent-hook.ps1",
              "routing-stop"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^vres-os:(sonnet-expert|opus-expert)$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/bin/vres-subagent-hook.ps1",
              "worker-stop"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^vres-os:validator$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PLUGIN_ROOT}/bin/vres-hook.ps1",
              "validator-stop"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
